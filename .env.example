# AllDebrid API Key (Generate one from https://alldebrid.com/apikeys)
ALLDEBRID_API_KEY=

# Server Configuration
PORT=3000
# Bind address (127.0.0.1 = local only; set 0.0.0.0 to expose on LAN, AUTH_TOKEN strongly recommended)
HOST=127.0.0.1

# Download Settings
DOWNLOAD_DIR=./downloads
MAX_CONCURRENT_DOWNLOADS=3

# Speed Limit in KB/s (0 = unlimited)
SPEED_LIMIT_KBPS=0

# Auto-retry attempts per file before marking it failed (0 = disabled)
MAX_RETRIES=3

# Pause all downloads when free space drops below this many GB (0 = disabled)
MIN_FREE_GB=5

# Access Protection (when set, all API/WebSocket calls require this token)
AUTH_TOKEN=

# Bandwidth Schedule (daily off-peak speed override)
SCHEDULE_ENABLED=0
SCHEDULE_START=23:00
SCHEDULE_END=07:00
SCHEDULE_LIMIT_KBPS=0

# Optional Jackett / Prowlarr Integration
JACKETT_URL=
JACKETT_API_KEY=
